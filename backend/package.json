{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "ve-xe-nhanh-backend",
  "version": "1.0.0",
  "description": "Vé xe nhanh Bus Booking System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seedData.js",
    "seed:dns": "node -r ./scripts/forceDns.js scripts/seedData.js",
    "seed:operators": "node scripts/seedBusOperators.js",
    "seed:operators:dns": "node -r ./scripts/forceDns.js scripts/seedBusOperators.js",
    "seed:stops": "node scripts/seedStopPoints.js",
    "seed:stops:dns": "node -r ./scripts/forceDns.js scripts/seedStopPoints.js",
    "seed:routes": "node scripts/seedRoutes.js",
    "seed:routes:dns": "node -r ./scripts/forceDns.js scripts/seedRoutes.js",
    "seed:employees": "node scripts/seedEmployees.js",
    "seed:employees:dns": "node -r ./scripts/forceDns.js scripts/seedEmployees.js",
    "seed:buses": "node scripts/seedBuses.js",
    "seed:buses:dns": "node -r ./scripts/forceDns.js scripts/seedBuses.js",
    "seed:trips": "node scripts/seedTrips.js",
    "seed:trips:dns": "node -r ./scripts/forceDns.js scripts/seedTrips.js",
    "seed:customer-history": "node scripts/seedCustomerHistory.js",
    "seed:customer-history:dns": "node -r ./scripts/forceDns.js scripts/seedCustomerHistory.js",
    "seed:complaint-customer": "node scripts/seedComplaintCustomer.js",
    "seed:complaint-customer:dns": "node -r ./scripts/forceDns.js scripts/seedComplaintCustomer.js",
    "seed:content": "node scripts/seedContent.js",
    "seed:content:dns": "node -r ./scripts/forceDns.js scripts/seedContent.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:admin:dns": "node -r ./scripts/forceDns.js scripts/seedAdmin.js",
    "clear": "node scripts/clearData.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\""
  },
  "keywords": [
    "bus-booking",
    "ticket-booking",
    "express",
    "mongodb",
    "redis"
  ],
  "author": "Vé xe nhanh Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "chalk": "^4.1.2",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.43",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.3",
    "redis": "^4.6.0",
    "socket.io": "^4.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^8.3.2",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "eslint": "^8.54.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.1.0",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
